+++ b/docs/modding/MOD_SEAMS.md
@@ -552,0 +553,2 @@ These events contain copied coordinates and scalar values. They do not carry a l
+`input-flush` reports a disturbance: something stopped a run, cancelled a rest or flushed the queued continuations. Declare `event:input-flush` to receive it. The engine's `disturb()` ends by signalling it, as upstream's does (player-util.c:1674), so it fires for every disturbance - the character taking a hit, a monster coming into view, a rest reaching its stopping condition, a light growing dim - and also when nothing needed cancelling, because the signal sits outside every cancel branch. The event carries no payload, and a mod that runs a multi-step action can stop on it when the world changes under the character. A handler that throws is logged, and the disturbance still completes. (neostryder/neo-angband#414)
+
diff --git a/packages/core/src/game/player-path.test.ts b/packages/core/src/game/player-path.test.ts
index e3a9c855..33efe0c1 100644
--- a/packages/core/src/game/player-path.test.ts
+++ b/packages/core/src/game/player-path.test.ts
@@ -8,0 +9 @@ import type { Loc } from "../loc.js";
+import { GameEvents } from "../events.js";
@@ -175,0 +177,41 @@ describe("running stops on disturbance", () => {
+describe("disturb() flushes the input (player-util.c:1674)", () => {
+  it("signals input-flush on the bus, once per disturbance, and needs no bus", () => {
+    const state = makeState({ w: 12, h: 7, playerGrid: loc(1, 3) });
+    /* No bus attached, the worldless harness shape: disturb() must not care,
+     * because hosts and headless cores are free to run without one. */
+    expect(() => disturb(state)).not.toThrow();
+
+    state.events = new GameEvents();
+    let heard = 0;
+    state.events.on("input-flush", () => heard++);
+    disturb(state);
+    disturb(state);
+    expect(heard).toBe(2);
+  });
+
+  it("signals with nothing to cancel, as upstream does", () => {
+    const state = makeState({ w: 12, h: 7, playerGrid: loc(1, 3) });
+    state.events = new GameEvents();
+    let heard = 0;
+    state.events.on("input-flush", () => heard++);
+    /* No run, no rest, no queued command: the signal sits outside every
+     * cancel block upstream, so a plain disturbance still reports. */
+    disturb(state);
+    expect(heard).toBe(1);
+  });
+
+  it("hands a throwing listener to onEventFault instead of its caller", () => {
+    const state = makeState({ w: 12, h: 7, playerGrid: loc(1, 3) });
+    state.events = new GameEvents();
+    const faults: string[] = [];
+    state.onEventFault = (type) => faults.push(type);
+    state.events.on("input-flush", () => {
+      throw new Error("listener failed");
+    });
+    /* disturb() runs deep inside run_step, take_hit and the world loop; a
+     * throwing listener must not cut any of those flows short. */
+    expect(() => disturb(state)).not.toThrow();
+    expect(faults).toEqual(["input-flush"]);
+  });
+});
+
diff --git a/packages/core/src/game/player-path.ts b/packages/core/src/game/player-path.ts
index 45c32280..41de7c20 100644
--- a/packages/core/src/game/player-path.ts
+++ b/packages/core/src/game/player-path.ts
@@ -107,0 +108,14 @@ export function disturb(state: GameState): void {
+  /* Flush input (player-util.c:1674): upstream's disturb() ends by signalling
+   * EVENT_INPUT_FLUSH unconditionally - outside every cancel block, so it fires
+   * whether or not anything was actually cancelled - and so does this one, so
+   * a subscriber with the event:input-flush grant hears every disturbance. A
+   * listener that throws is handed to onEventFault instead of escaping into
+   * whichever engine flow called disturb(), the same posture as the
+   * dungeonlevel sender (resolved-events.ts). */
+  if (state.events) {
+    try {
+      state.events.signal("input-flush");
+    } catch (error) {
+      state.onEventFault?.("input-flush", error);
+    }
+  }
